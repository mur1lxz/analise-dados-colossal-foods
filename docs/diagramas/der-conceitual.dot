digraph DER {
  graph [layout=dot, rankdir=LR, splines=true, nodesep=0.35, ranksep=0.55, compound=true, fontname="Helvetica", labelloc=t, fontsize=22, pad=0.3, label="DER conceitual revisado — Colossal Foods (notação brModelo; identificador sublinhado; (mín, máx))"];
  node [fontname="Helvetica", fontsize=11]; edge [dir=none, color="#1f2933", fontname="Helvetica", fontsize=10, fontcolor="#2f5d8a", labeldistance=1.6, labelangle=25];
  CLIENTE [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>CLIENTE</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_cliente</U></TD></TR><TR><TD ALIGN="LEFT">nome</TD></TR><TR><TD ALIGN="LEFT">telefone</TD></TR></TABLE>>];
  PEDIDO [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>PEDIDO</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_pedido</U></TD></TR><TR><TD ALIGN="LEFT">data_hora</TD></TR><TR><TD ALIGN="LEFT">tipo_pedido</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
  PRODUTO [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>PRODUTO</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_produto</U></TD></TR><TR><TD ALIGN="LEFT">nome</TD></TR><TR><TD ALIGN="LEFT">descricao</TD></TR><TR><TD ALIGN="LEFT">preco</TD></TR><TR><TD ALIGN="LEFT">disponivel</TD></TR></TABLE>>];
  CATEGORIA [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>CATEGORIA</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_categoria</U></TD></TR><TR><TD ALIGN="LEFT">nome</TD></TR><TR><TD ALIGN="LEFT">descricao</TD></TR></TABLE>>];
  INGREDIENTE [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>INGREDIENTE</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_ingrediente</U></TD></TR><TR><TD ALIGN="LEFT">nome</TD></TR><TR><TD ALIGN="LEFT">unidade_medida</TD></TR><TR><TD ALIGN="LEFT">estoque_minimo</TD></TR></TABLE>>];
  FORNECEDOR [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>FORNECEDOR</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_fornecedor</U></TD></TR><TR><TD ALIGN="LEFT">nome</TD></TR><TR><TD ALIGN="LEFT">telefone</TD></TR><TR><TD ALIGN="LEFT">email</TD></TR></TABLE>>];
  PAGAMENTO [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>PAGAMENTO</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_pagamento</U></TD></TR><TR><TD ALIGN="LEFT">forma_pagamento</TD></TR><TR><TD ALIGN="LEFT">valor</TD></TR><TR><TD ALIGN="LEFT">data_hora</TD></TR></TABLE>>];
  ENTREGA [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>ENTREGA</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_entrega</U></TD></TR><TR><TD ALIGN="LEFT">endereco (logradouro, numero,</TD></TR><TR><TD ALIGN="LEFT">   complemento, cep)</TD></TR><TR><TD ALIGN="LEFT">taxa_entrega_aplicada</TD></TR><TR><TD ALIGN="LEFT">data_hora_saida</TD></TR><TR><TD ALIGN="LEFT">data_hora_entrega</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
  MOTOBOY [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>MOTOBOY</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_motoboy</U></TD></TR><TR><TD ALIGN="LEFT">nome</TD></TR><TR><TD ALIGN="LEFT">telefone</TD></TR></TABLE>>];
  AREA_ENTREGA [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>AREA_ENTREGA</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_area_entrega</U></TD></TR><TR><TD ALIGN="LEFT">bairro</TD></TR><TR><TD ALIGN="LEFT">taxa_padrao</TD></TR><TR><TD ALIGN="LEFT">ativo</TD></TR></TABLE>>];
  FUNCIONARIO [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>FUNCIONARIO</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_funcionario</U></TD></TR><TR><TD ALIGN="LEFT">nome</TD></TR><TR><TD ALIGN="LEFT">funcao</TD></TR><TR><TD ALIGN="LEFT">telefone</TD></TR><TR><TD ALIGN="LEFT">ativo</TD></TR></TABLE>>];
  HISTORICO_STATUS_PEDIDO [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>HISTORICO_STATUS_PEDIDO</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_historico</U></TD></TR><TR><TD ALIGN="LEFT">status_anterior</TD></TR><TR><TD ALIGN="LEFT">status_novo</TD></TR><TR><TD ALIGN="LEFT">data_hora</TD></TR><TR><TD ALIGN="LEFT">motivo</TD></TR></TABLE>>];
  COMPRA [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>COMPRA</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_compra</U></TD></TR><TR><TD ALIGN="LEFT">data_pedido</TD></TR><TR><TD ALIGN="LEFT">data_recebimento</TD></TR><TR><TD ALIGN="LEFT">numero_nota_fiscal</TD></TR><TR><TD ALIGN="LEFT">status_compra</TD></TR><TR><TD ALIGN="LEFT">resultado_conferencia</TD></TR><TR><TD ALIGN="LEFT">observacao_conferencia</TD></TR></TABLE>>];
  MOVIMENTACAO_ESTOQUE [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>MOVIMENTACAO_ESTOQUE</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_movimentacao</U></TD></TR><TR><TD ALIGN="LEFT">tipo_movimentacao</TD></TR><TR><TD ALIGN="LEFT">quantidade</TD></TR><TR><TD ALIGN="LEFT">data_hora</TD></TR><TR><TD ALIGN="LEFT">motivo</TD></TR></TABLE>>];
  FECHAMENTO_CAIXA [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>FECHAMENTO_CAIXA</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_fechamento</U></TD></TR><TR><TD ALIGN="LEFT">data_hora_inicio</TD></TR><TR><TD ALIGN="LEFT">data_hora_fim</TD></TR><TR><TD ALIGN="LEFT">observacao</TD></TR></TABLE>>];
  CONFERENCIA_CAIXA [shape=plaintext, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eef4fb" COLOR="#1f2933"><TR><TD BGCOLOR="#cfe0f5" COLSPAN="1"><B>CONFERENCIA_CAIXA</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_conferencia</U></TD></TR><TR><TD ALIGN="LEFT">forma_pagamento</TD></TR><TR><TD ALIGN="LEFT">valor_contado</TD></TR></TABLE>>];
  R_REALIZA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="REALIZA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  CLIENTE -> R_REALIZA [taillabel="(1,1)"];
  R_REALIZA -> PEDIDO [headlabel="(0,n)"];
  R_CONTÉM [shape=diamond, style=filled, fillcolor="#fdf3e1", label="CONTÉM", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  PEDIDO -> R_CONTÉM [taillabel="(0,n)"];
  R_CONTÉM -> PRODUTO [headlabel="(1,n)"];
  A_R_CONTÉM_quantidade [shape=plaintext, label="○ quantidade", fontsize=10];
  R_CONTÉM -> A_R_CONTÉM_quantidade [color="#7b8794", minlen=1];
  A_R_CONTÉM_preco_unitario [shape=plaintext, label="○ preco_unitario", fontsize=10];
  R_CONTÉM -> A_R_CONTÉM_preco_unitario [color="#7b8794", minlen=1];
  A_R_CONTÉM_observacao [shape=plaintext, label="○ observacao", fontsize=10];
  R_CONTÉM -> A_R_CONTÉM_observacao [color="#7b8794", minlen=1];
  R_CLASSIFICA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="CLASSIFICA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  CATEGORIA -> R_CLASSIFICA [taillabel="(1,1)"];
  R_CLASSIFICA -> PRODUTO [headlabel="(0,n)"];
  R_COMPÕE [shape=diamond, style=filled, fillcolor="#fdf3e1", label="COMPÕE", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  PRODUTO -> R_COMPÕE [taillabel="(0,n)"];
  R_COMPÕE -> INGREDIENTE [headlabel="(0,n)"];
  A_R_COMPÕE_quantidade_utilizada [shape=plaintext, label="○ quantidade_utilizada", fontsize=10];
  R_COMPÕE -> A_R_COMPÕE_quantidade_utilizada [color="#7b8794", minlen=1];
  R_FORNECE [shape=diamond, style=filled, fillcolor="#fdf3e1", label="FORNECE", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FORNECEDOR -> R_FORNECE [taillabel="(1,n)"];
  R_FORNECE -> INGREDIENTE [headlabel="(1,n)"];
  R_QUITA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="QUITA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  PEDIDO -> R_QUITA [taillabel="(1,1)"];
  R_QUITA -> PAGAMENTO [headlabel="(0,1)"];
  R_GERA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="GERA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  PEDIDO -> R_GERA [taillabel="(1,1)"];
  R_GERA -> ENTREGA [headlabel="(0,1)"];
  R_TRANSPORTA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="TRANSPORTA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  MOTOBOY -> R_TRANSPORTA [taillabel="(1,1)"];
  R_TRANSPORTA -> ENTREGA [headlabel="(0,n)"];
  R_DESTINA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="DESTINA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  AREA_ENTREGA -> R_DESTINA [taillabel="(1,1)"];
  R_DESTINA -> ENTREGA [headlabel="(0,n)"];
  R_REGISTRA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="REGISTRA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FUNCIONARIO -> R_REGISTRA [taillabel="(1,1)"];
  R_REGISTRA -> PEDIDO [headlabel="(0,n)"];
  R_PREPARA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="PREPARA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FUNCIONARIO -> R_PREPARA [taillabel="(0,1)"];
  R_PREPARA -> PEDIDO [headlabel="(0,n)"];
  R_TEM [shape=diamond, style=filled, fillcolor="#fdf3e1", label="TEM", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  PEDIDO -> R_TEM [taillabel="(1,1)"];
  R_TEM -> HISTORICO_STATUS_PEDIDO [headlabel="(1,n)"];
  R_ALTERA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="ALTERA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FUNCIONARIO -> R_ALTERA [taillabel="(1,1)"];
  R_ALTERA -> HISTORICO_STATUS_PEDIDO [headlabel="(0,n)"];
  R_AUTORIZA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="AUTORIZA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FUNCIONARIO -> R_AUTORIZA [taillabel="(0,1)"];
  R_AUTORIZA -> HISTORICO_STATUS_PEDIDO [headlabel="(0,n)"];
  R_ABASTECE [shape=diamond, style=filled, fillcolor="#fdf3e1", label="ABASTECE", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FORNECEDOR -> R_ABASTECE [taillabel="(1,1)"];
  R_ABASTECE -> COMPRA [headlabel="(0,n)"];
  R_CONFERE [shape=diamond, style=filled, fillcolor="#fdf3e1", label="CONFERE", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FUNCIONARIO -> R_CONFERE [taillabel="(0,1)"];
  R_CONFERE -> COMPRA [headlabel="(0,n)"];
  R_MOVIMENTA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="MOVIMENTA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  INGREDIENTE -> R_MOVIMENTA [taillabel="(1,1)"];
  R_MOVIMENTA -> MOVIMENTACAO_ESTOQUE [headlabel="(0,n)"];
  R_LANÇA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="LANÇA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FUNCIONARIO -> R_LANÇA [taillabel="(1,1)"];
  R_LANÇA -> MOVIMENTACAO_ESTOQUE [headlabel="(0,n)"];
  R_CONCILIA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="CONCILIA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FECHAMENTO_CAIXA -> R_CONCILIA [taillabel="(0,1)"];
  R_CONCILIA -> PAGAMENTO [headlabel="(0,n)"];
  R_FECHA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="FECHA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FUNCIONARIO -> R_FECHA [taillabel="(0,1)"];
  R_FECHA -> FECHAMENTO_CAIXA [headlabel="(0,n)"];
  R_DETALHA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="DETALHA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  FECHAMENTO_CAIXA -> R_DETALHA [taillabel="(1,1)"];
  R_DETALHA -> CONFERENCIA_CAIXA [headlabel="(1,n)"];
  subgraph cluster_item_compra { style="bold"; color="#1f2933"; penwidth=2; label="entidade associativa"; fontsize=9; fontcolor="#52606d"; margin=10;
    R_ITEM_COMPRA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="ITEM_COMPRA", fontsize=10, width=1.4, height=0.6, fixedsize=true];
    A_R_ITEM_COMPRA_quantidade_solicitada [shape=plaintext, label="○ quantidade_solicitada", fontsize=10];
    A_R_ITEM_COMPRA_quantidade_recebida [shape=plaintext, label="○ quantidade_recebida", fontsize=10];
    A_R_ITEM_COMPRA_custo_unitario [shape=plaintext, label="○ custo_unitario", fontsize=10];
  }
  R_ITEM_COMPRA -> A_R_ITEM_COMPRA_quantidade_solicitada [color="#7b8794", minlen=1];
  R_ITEM_COMPRA -> A_R_ITEM_COMPRA_quantidade_recebida [color="#7b8794", minlen=1];
  R_ITEM_COMPRA -> A_R_ITEM_COMPRA_custo_unitario [color="#7b8794", minlen=1];
  COMPRA -> R_ITEM_COMPRA [taillabel="(0,n)", lhead=cluster_item_compra];
  R_ITEM_COMPRA -> INGREDIENTE [headlabel="(1,n)", ltail=cluster_item_compra];
  R_ORIGINA [shape=diamond, style=filled, fillcolor="#fdf3e1", label="ORIGINA", fontsize=10, width=1.3, height=0.6, fixedsize=true];
  R_ITEM_COMPRA -> R_ORIGINA [taillabel="(0,1)", ltail=cluster_item_compra];
  R_ORIGINA -> MOVIMENTACAO_ESTOQUE [headlabel="(0,n)"];
}