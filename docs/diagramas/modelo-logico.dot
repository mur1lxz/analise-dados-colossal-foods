digraph LOGICO {
  graph [layout=dot, rankdir=LR, splines=true, nodesep=0.3, ranksep=0.9, fontname="Helvetica", labelloc=t, fontsize=22, pad=0.3, label="Modelo lógico relacional — Colossal Foods (MySQL; 20 tabelas; PK, FK e (mín, máx))"];
  node [fontname="Helvetica", fontsize=11, shape=plaintext]; edge [dir=none, color="#52606d", fontname="Helvetica", fontsize=10, fontcolor="#2f5d8a", labeldistance=1.7, labelangle=20];
